NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ISO 4217 code used to format prices (e.g. in OG images)
NEXT_PUBLIC_STORE_CURRENCY=GBP

# Canonical origin, no trailing slash. Required off Vercel, or every canonical
# and sitemap entry ships as localhost:3000. Commented out on purpose: it is
# checked BEFORE the Vercel vars, so a copied value pins production to localhost.
# NEXT_PUBLIC_SITE_URL=https://example.com
